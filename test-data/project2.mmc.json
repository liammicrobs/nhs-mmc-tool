  "constraintsScorecard": {
    "items": [
      {
        "id": "a9a781f7-a42c-45fb-aa21-ee077336f7f0",
        "name": "Proton beam therapy suite tolerances",
        "score": 8,
        "description": "Extreme precision requirements (+/- 1mm) for the proton beam therapy bunker may limit applicability of some MMC systems. Hybrid approach with in-situ concrete for the bunker itself."
      },
      {
        "id": "98a81f4f-805f-4603-bd65-326f91b2ebbb",
        "name": "Insurance and warranties for novel systems",
        "score": 4,
        "description": "Some insurers require additional evidence for novel MMC systems. BAM's track record and BOPAS certification mitigate this risk."
      }
    ],
    "workshopAttendees": [
      "Michael van den Berg",
      "Chris Sheridan",
      "Fiona Stewart"
    ]
  },

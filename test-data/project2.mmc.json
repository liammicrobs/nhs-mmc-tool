  "benefitsScorecard": {
    "items": [
      {
        "id": "35c9de8a-1ec9-4d3e-9432-3db75bd6c4a1",
        "category": "faster",
        "name": "Reduced programme duration",
        "importance": 9,
        "points": 75,
        "description": "Parallel off-site manufacture and on-site foundations reduces programme by 18 weeks compared to traditional construction"
      },
      {
        "id": "57739328-de67-41f2-b7fb-14334bf87df0",
        "category": "faster",
        "name": "Accelerated fit-out through pre-assembly",
        "importance": 8,
        "points": 65,
        "description": "Pre-assembled service modules and completed bathroom pods enable rapid floor-by-floor fit-out"
      },
      {
        "id": "e17f0d26-8ac9-4f5a-b78d-07f1a770f64b",
        "category": "better",
        "name": "Improved quality control",
        "importance": 10,
        "points": 80,
        "description": "Factory-controlled environment ensures consistent quality critical for proton beam therapy suite tolerances"
      },
      {
        "id": "d63b51e7-1f7f-4bba-8eac-ac35508b5967",
        "category": "better",
        "name": "Reduced on-site health and safety risk",
        "importance": 7,
        "points": 60,
        "description": "Reduction in working at height and hot works through factory-based assembly of facade and structural elements"
      },
      {
        "id": "d7043d85-96ce-4b52-a1cf-284be31ca1d2",
        "category": "sustainable_legacy",
        "name": "Reduced embodied carbon",
        "importance": 8,
        "points": 70,
        "description": "Optimised material use in factory production and reduced transport movements contribute to 25% reduction in embodied carbon"
      },
      {
        "id": "52a05d95-ab5f-44d0-a5e1-29131ab11040",
        "category": "economic",
        "name": "Cost certainty improvement",
        "importance": 7,
        "points": 55,
        "description": "Fixed-price manufacturing contracts for major elements reduce cost risk exposure by approximately 30%"
      }
    ],

  "constraintsScorecard": {
    "items": [
      {
        "id": "29b62953-a672-4fed-abcf-419795e72e0a",
        "name": "Site access and logistics",
        "score": 6,
        "description": "Constrained urban site with single access road limits delivery windows for large volumetric modules. Tower crane capacity adequate for panel systems but not full volumetric."
      },
      {
        "id": "0d19a817-fd40-4755-9c9b-9b10e582da37",
        "name": "Supply chain readiness",
        "score": 5,
        "description": "Limited number of suppliers with healthcare-specific MMC experience at required scale. Lead times for bathroom pods currently 16-20 weeks."
      },
